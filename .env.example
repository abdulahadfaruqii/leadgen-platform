# ==========================================
# LEADGEN PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Application
APP_NAME=LeadGen AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-in-production
API_V1_PREFIX=/api/v1

# Database - PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_secret
POSTGRES_DB=leadgen
DATABASE_URL=postgresql+asyncpg://leadgen:leadgen_secret@postgres:5432/leadgen

# Database - MongoDB
MONGO_SERVER=mongo
MONGO_PORT=27017
MONGO_USER=leadgen
MONGO_PASS=mongo_secret
MONGO_DB=leadgen_analytics
MONGO_URL=mongodb://leadgen:mongo_secret@mongo:27017/leadgen_analytics?authSource=admin

# Redis
REDIS_SERVER=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=leadgen_memory

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
KIMI_API_KEY=...

# AI Configuration
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o
FALLBACK_AI_PROVIDER=anthropic
FALLBACK_AI_MODEL=claude-3-5-sonnet-20241022

# Scraping
PLAYWRIGHT_HEADLESS=true
PROXY_ROTATION_ENABLED=false
PROXY_LIST=
SCRAPING_DELAY_MS=1500
MAX_RETRIES=3
RATE_LIMIT_RPS=2

# Search APIs
SERPAPI_KEY=...
GOOGLE_MAPS_API_KEY=...
BING_SEARCH_API_KEY=...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
